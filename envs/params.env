# ---------------- PAIRS SEARCH -----------------

TF=1
# таймфрейм для визначення показників інструменту

EXCLUDED="BTCUSDT, ETHUSDT"

UPDATE_TIME_HOURS=1
# як часто оновлювати список робочих інструментів (в годинах)

TICKSIZE_FILTER=0.03
# максимальний розмір тіку в %

ATR_FILTER=0.30
# мінімальний середній ATR на вікно пошуку (KLINES_LEN)

PAIRS_LIMIT=50
# макс. кількість інструментів для аналізу (обережно з KLINES_LEN та 429 помилкою - уникай бану!)

SPOT_VERIFIED=on
# тільки інструменти, які мають спотовий відповідник

# ----------------- SIZE SEARCH -----------------

DEPTH_LEN=500
# базова висота стакану

MIN_DEPTH_LEN=100
# мінімальне значення висоти depth до помилки

KLINES_LEN=200
# вікно пошуку на графіку

MIN_KLINES_LEN=150
# мінімальне значення запиту klines до помилки

C_ROOM=30
# кімната зліва

D_ROOM=10
# вікно зверху і знизу стакану

WIGGLE_ROOM_PERC=10
#WIGGLE_ROOM_PERC=0.2
# вікно допуску сайзу в стакані відносно рівня на графіку вгору і вниз

SIZE_VS_DOM_MPL=2
# мультиплікатор максимального сайзу відносно інших сайзів в стакані

SIZE_VS_AVG_MPL=5
# мультиплікатор відносності об'єму до підвальних об'ємів

REPEAT_COUNTER=999
# мінімальна кількість повторень для сигналу

